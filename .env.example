# Copy to .env.local and fill in values from a DEVELOPMENT Supabase project.
# Never commit real values. Never prefix server secrets with NEXT_PUBLIC_.

# Browser-safe (RLS protects all data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used ONLY by `bun run provision:owner`; the web app never reads it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Live mode requires BOTH this flag and stores.mode = 'live' (service-role change).
STORE_MODE=demo
STORE_TIMEZONE=Asia/Jakarta

# Later phases (server-only):
# RAJAONGKIR_API_KEY=
# BITESHIP_API_KEY=
# SHIPPING_PROVIDER=rajaongkir
